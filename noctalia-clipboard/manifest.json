{
  "id": "noctalia-clipboard",
  "name": "Noctalia Clipboard",
  "version": "1.0.0",
  "minNoctaliaVersion": "3.6.0",
  "author": "Ilya Kardapolov (ZeeFleX)",
  "license": "MIT",
  "repository": "https://github.com/ZeeFleX/noctalia-plugins",
  "description": "Clipboard history manager with search. Powered by cliphist. Click bar icon to browse, search and paste previous copies.",
  "tags": [
    "Bar",
    "Clipboard",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "barWidget": "BarWidget.qml",
    "settings": "Settings.qml"
  },
  "metadata": {
    "defaultSettings": {
      "maxItems": 50,
      "previewWidth": 60,
      "showCount": true,
      "persistFilter": true
    }
  }
}
