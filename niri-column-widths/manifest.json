{
  "id": "niri-column-widths",
  "name": "Niri Column Widths",
  "version": "1.0.0",
  "minNoctaliaVersion": "3.6.0",
  "author": "Ilya Kardapolov (ZeeFleX)",
  "license": "MIT",
